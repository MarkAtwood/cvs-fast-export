def resolve_repository_argument(directory, whole_repo=False):
    "Resolve a repository argument into its CVS root and optional module."
    directory = os.path.normpath(directory)
    if whole_repo or not os.path.exists(directory):
        return (directory, None)

    if os.path.isdir(os.path.join(directory, "CVSROOT")):
        candidates = sorted(
            sub
            for sub in os.listdir(directory)
            if sub != "CVSROOT" and os.path.isdir(os.path.join(directory, sub))
        )
        if not candidates:
            raise ValueError("cvsconvert: no modules under %s." % directory)
        if len(candidates) > 1:
            raise ValueError("cvsconvert: choose one of %s" % candidates)
        return (directory, candidates[0])

    parent = os.path.dirname(directory) or os.curdir
    if os.path.isdir(os.path.join(parent, "CVSROOT")):
        return (parent, os.path.basename(directory))
    return (directory, None)


