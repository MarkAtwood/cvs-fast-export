            sys.stderr.write(
                err_leader
                + "cvsconvert: repo directory cannot be the current directory.\n"
            )
            sys.exit(1)
        cc = ConvertComparison(
            srepo=repo,
            smodule=module,
            checkout=None,
            options=engine_opts,
            showdiffs=True,
            tapify=tap_output,
            whole_repo=whole_repo,
        )
        if verbose == 0 and "-p" in engine_opts:
            verbose = DEBUG_STEPS
        cc.repo.retain = retain
        cc.checkall()
        cc.checkout.cleanup()
        if retain:
            sys.stderr.write(
                err_leader + "cvsconvert: conversion is in %s\n" % (cc.gitRepoName)
            )
        else:
            cc.cleanup()

